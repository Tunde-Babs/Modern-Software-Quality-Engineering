{
  "name": "msqe-portal",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check && tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build && pagefind --site dist && node scripts/prune-search.mjs",
    "verify": "npm run check && npm test && npm run build && node --import tsx tests/build-smoke.ts",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "links": "node --import tsx scripts/external-links.ts",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "astro": "7.3.2",
    "github-slugger": "2.0.0",
    "hast-util-to-string": "3.0.1",
    "mdast-util-to-string": "4.0.0",
    "rehype-sanitize": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/hast": "3.0.5",
    "@types/mdast": "4.0.4",
    "@types/node": "22.20.2",
    "cheerio": "1.2.0",
    "pagefind": "1.5.2",
    "tsx": "4.23.13",
    "typescript": "6.0.3"
  }
}
