---
import Base from './Base.astro';
import Readiness from '../components/Readiness.astro';
import { loadParts } from '../lib/content/loader';
interface Props { part: ReturnType<typeof loadParts>[number] }
const { part } = Astro.props;
const parts = loadParts();
---
<Base title={part.title} description={part.description || part.title}>
  <div class="page index-page" data-pagefind-body>
    <nav class="breadcrumb" aria-label="Breadcrumb" data-pagefind-ignore><ol><li><a href="/">MSQE</a></li><li><a href="/handbook/">Handbook</a></li><li aria-current="page">Part {part.number}</li></ol></nav>
    <h1>{part.title}</h1><p>{part.description}</p><Readiness />
    <h2>Chapters</h2>
    <ol class="curriculum">{part.chapters.map(doc => <li>
      <a href={doc.route}>{doc.title}</a>
      <p>{doc.metadata?.['Estimated study time']} · Status: {doc.metadata?.Status} · Version: {doc.metadata?.Version}</p>
      <p>Prerequisites: {doc.metadata?.Prerequisites}</p>
    </li>)}</ol>
    <nav class="chapter-pagination" aria-label="Part navigation" data-pagefind-ignore>
      <div>{parts[part.number - 2] && <a rel="prev" href={parts[part.number - 2].route}>Previous: {parts[part.number - 2].title}</a>}</div>
      <div>{parts[part.number] && <a rel="next" href={parts[part.number].route}>Next: {parts[part.number].title}</a>}</div>
    </nav>
  </div>
</Base>
