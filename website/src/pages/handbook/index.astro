---
import Base from '../../layouts/Base.astro';
import Readiness from '../../components/Readiness.astro';
import { loadParts } from '../../lib/content/loader';
const parts = loadParts();
---
<Base title="Handbook" description="Explore all 137 chapters across the 12 Parts of Modern Software Quality Engineering.">
  <div class="page index-page" data-pagefind-body>
    <p class="eyebrow">Read · Reason · Apply</p><h1>Handbook</h1>
    <p class="subtitle">137 chapters · 12 Parts</p>
    <p>Progress from foundations and programming through testing, data, cloud, AI, architecture, and engineering leadership.</p>
    <Readiness />
    <ol class="curriculum">{parts.map(part => <li>
      <h2><a href={part.route}>{part.title}</a></h2><p>{part.description}</p>
      <p>{part.chapters.length} chapters · Manuscript status: Draft</p>
      <a href={part.chapters[0].route}>Start Part {part.number}</a>
    </li>)}</ol>
  </div>
</Base>
