{
  "name": "msqe-capstone-quality-engineering-toolkit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Reference implementation for the MSQE Part II Quality Engineering Toolkit capstone.",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc --noEmit false --outDir .build",
    "check": "tsc --noEmit",
    "start": "npm run build && node .build/src/runToolkit.js",
    "test": "npm run build && node --test .build/test/configuration.test.js .build/test/executionValidation.test.js .build/test/analysis.test.js .build/test/asyncUtilities.test.js .build/test/workflow.test.js",
    "validate": "npm run check && npm run test"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "typescript": "^5.9.3"
  }
}
